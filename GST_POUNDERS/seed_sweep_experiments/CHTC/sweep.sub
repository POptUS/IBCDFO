# HTCondor submit: pilot-shot sweep. No container -- a portable venv is shipped.
#   python make_joblist.py && condor_submit sweep.sub

universe                = vanilla
executable              = job.sh
arguments               = $(pilot) $(seed)

# PyROL wheel is manylinux_2_28 -> needs glibc >= 2.28 (EL8+)
requirements            = (OpSysMajorVer >= 8)

# TEST 1: pilot-shot sweep. Pin the total budget so the pilot is the ONLY variable.
# Unpinned, the budget = fixed_fpr_shots x (circuits FPR reveals), which is
# trajectory-dependent and swings 42% across seeds.
environment             = "SWEEP_ARGS='--budget 550000'"

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = rolenv.tar.gz, code.tar.gz, run_one.py, experiment_config.json
transfer_output_files   = out_p$(pilot)_s$(seed).tar.gz

# raise if a cell OOMs or runs long; one cell = all methods for one seed
request_cpus            = 1
request_memory          = 4GB
request_disk            = 6GB

log                     = logs/sweep.log
output                  = logs/out_p$(pilot)_s$(seed).txt
error                   = logs/err_p$(pilot)_s$(seed).txt

# resume-friendly: a killed job restarts cleanly, nothing is shared between jobs
max_retries             = 2
on_exit_hold            = (ExitCode != 0)

queue pilot,seed from joblist.txt
