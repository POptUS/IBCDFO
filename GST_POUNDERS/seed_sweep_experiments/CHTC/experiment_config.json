{
  "model_kind": "1Q",
  "modelpack_1q": "smq1Q_XYZI",
  "modelpack_2q": "smq2Q_XYICNOT",
  "max_lengths": [1, 2, 4, 8, 16, 32, 64],
  "parameterization": "CPTPLND",

  "truth_seed": 1000,
  "vary_truth_with_data_seed": false,
  "noise_model": "lindblad_hard",
  "spam_noise": 0.005,
  "lindblad_h_max": 0.01,
  "lindblad_s_max": 0.004,
  "lindblad_a_max": 0.004,
  "op_noise": 0.002,
  "coherent_max_rotate": 0.12,

  "sample_error": "multinomial",
  "objective": "weighted_least_squares",
  "variance_source": "data",
  "variance_floor": 1e-12,
  "probability_tolerance": 1e-8,

  "nfmax": 500,
  "gtol": 0.0001,
  "initial_delta": 0.1,
  "lower_bound": -3.141592653589793,
  "upper_bound": 3.141592653589793,
  "pyrol_max_iters": 10,
  "require_pyrol": true,

  "use_fpr_union_mask": true,
  "rho_uses_full_objective": false,
  "fpr_stage1_method": "twirled_derivative",
  "fpr_stage2_method": "paper_greedy",
  "fpr_verbose": false,

  "fixed_no_fpr_shots": 250,
  "fixed_fpr_shots": 1000,

  "adaptive_baseline_shots": 500,
  "adaptive_criterion": "D",
  "adaptive_total_shot_budget": 300000,
  "adaptive_schedule": "lazy_delta_inverse_square",
  "adaptive_schedule_base": 1.03,
  "adaptive_schedule_n0": 220,
  "adaptive_schedule_n_max": 12000,
  "adaptive_delta_inverse_square_constant": 0.005,
  "adaptive_delta_inverse_square_n_min": 0,
  "adaptive_delta_inverse_fourth_constant": 0.0001,
  "adaptive_delta_inverse_fourth_n_min": 0,
  "adaptive_delta_floor": 1e-12,
  "adaptive_rho_band": 0.5,
  "adaptive_initial_topup": 0,

  "save_iteration_models": true,
  "report_diamond_distance": true
}
