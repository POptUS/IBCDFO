# HTCondor submit description. One job per line of joblist.txt.
#
# joblist.txt columns:  <seed>, <tag>, <extra run_one.py args>
# The tag must be unique per job: it names the returned tarball, and several jobs can share a
# seed (one per baseline fraction, say). make_jobs.py guarantees uniqueness.
#
#   condor_submit sweep.sub
universe                = vanilla
executable              = job.sh
arguments               = $(seed) $(tag) $(sweep_args)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_input_files    = rolenv.tar.gz, code.tar.gz, experiment_config.json
transfer_output_files   = out_$(tag).tar.gz

log                     = logs/job_$(tag).log
output                  = logs/job_$(tag).out
error                   = logs/job_$(tag).err

# Write stdout/stderr back to logs/ AS THE JOB RUNS instead of shipping them at exit.
# Without this, when_to_transfer_output = ON_EXIT spools both on the execute node and the
# local .out/.err do not exist until the job finishes -- so a running job looks like it is
# producing nothing, and a job that dies without exiting cleanly leaves no output at all.
#
# The cost is a live connection per job plus continuous network writes, and PyROL prints an
# iteration table per trust-region subproblem solve, so this is chatty. For a large
# submission turn it off at submit time rather than editing this file:
#     condor_submit sweep.sub -a "JOBLIST=..." -a "stream_output=False" -a "stream_error=False"
stream_output           = True
stream_error            = True

# One core on purpose -- see the threading note in job.sh. Memory is dominated by the
# 1918x72 Jacobians and pygsti's model cache; 8 GB has ample headroom.
request_cpus            = 1
request_memory          = 8GB
request_disk            = 6GB

requirements            = (OpSysMajorVer >= 8)
max_retries             = 2
+WantFlocking           = true

# Allow the job past the default 72-hour wall clock. 1-qubit runs finish in minutes, but a
# 2-qubit job is estimated at ~22 h at max_lengths 1..8 and ~47 h at 1..64 -- and that
# estimate extrapolates a Jacobian timing from a small sample, so it can be well off on
# slower execute nodes. There is no checkpointing in run_one.py: a job killed at the wall
# clock restarts from zero, so the cost of setting this unnecessarily is nil next to the
# cost of not setting it.
+LongJob                = true

# Override to resubmit only the failures:
#     condor_submit sweep.sub -a "JOBLIST=joblist_retry.txt"
JOBLIST = joblist.txt
queue seed, tag, sweep_args from $(JOBLIST)
