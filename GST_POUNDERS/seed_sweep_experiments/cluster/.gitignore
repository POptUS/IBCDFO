# built once per cluster, ~300 MB -- regenerate with build_env.sh, never commit
rolenv/
rolenv.tar.gz

# vendored source: output of vendor.sh. A second copy of files already in this repo, which
# would silently drift. Regenerate before every submit.
code/
code.tar.gz

# per-submit scratch.
# Globbed, not literal: --tag-prefix puts a sweep name in front of the tag (out_b500_s101_...)
# and --out names the joblist per sweep (joblist_500.txt), so 'out_s*' and the two literal
# joblist names stopped matching and the tarballs showed up as untracked.
joblist*.txt
logs/
out_*.tar.gz
collected/
sweep_summary.csv
fpr_builtin/

# vendor.sh copies the live config here; the source of truth is ../experiment_config.json
experiment_config.json
__pycache__/
